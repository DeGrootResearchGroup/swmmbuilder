[TITLE]
;;swmmbuilder template. SI units: FLOW_UNITS LPS (flow in L/s; lengths, elevations
;;and sizes in m). The placeholders in braces are filled by swmmbuilder.swmm.

[OPTIONS]
;;Options            Value
;;------------------ ------------
FLOW_UNITS           LPS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           10/01/2016
START_TIME           00:00:00
REPORT_START_DATE    10/01/2016
REPORT_START_TIME    00:00:00
END_DATE             10/04/2016
END_TIME             00:00:00
SWEEP_START          01/01 ;; for street sweeping
SWEEP_END            12/31 ;; for street sweeping
DRY_DAYS             0
REPORT_STEP          00:10:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         30
ALLOW_PONDING        NO
INERTIAL_DAMPING     NONE
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         0
NORMAL_FLOW_LIMITED  BOTH
SKIP_STEADY_STATE    NO
FORCE_MAIN_EQUATION  H-W
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
MAX_TRIALS           8
HEAD_TOLERANCE       0.005
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
;;MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Type          Parameters
;;------------- ----------
CONSTANT     0.0
DRY_ONLY     NO

[JUNCTIONS]
;;               Invert     Max.       Init.      Surcharge  Ponded
;;Name           Elev.      Depth      Depth      Depth      Area
;;-------------- ---------- ---------- ---------- ---------- ----------
{nodes}

[OUTFALLS]
;;               Invert     Outfall      Stage/Table      Tide
;;Name           Elev.      Type         Time Series      Gate Route To
;;-------------- ---------- ------------ ---------------- ---- ----------------
{outfalls}

[STORAGE]
;;               Invert   Max.     Init.    Storage    Curve                      Ponded   Evap.
;;Name           Elev.    Depth    Depth    Curve      Params                     Area     Frac.
;;-------------- -------- -------- -------- ---------- -------- -------- -------- -------- --------
{storage}

[CONDUITS]
;;               Inlet            Outlet                      Manning    Inlet      Outlet     Init.      Max.
;;Name           Node             Node             Length     N          Offset     Offset     Flow       Flow
;;-------------- ---------------- ---------------- ---------- ---------- ---------- ---------- ---------- ----------
{conduits}

[PUMPS]
;;               Inlet            Outlet           Pump             Init.  Startup    Shutoff
;;Name           Node             Node             Curve            Status Depth      Depth
;;-------------- ---------------- ---------------- ---------------- ------ ---------- ----------
{pumps}

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels
;;-------------- ------------ ---------------- ---------- ---------- ---------- ----------
{xsections}

[LOSSES]
;;Link           Inlet      Outlet     Average    Flap Gate  SeepageRate
;;-------------- ---------- ---------- ---------- ---------- ----------

[INFLOWS]
;;                                                 Param    Units    Scale    Baseline Baseline
;;Node           Parameter        Time Series      Type     Factor   Factor   Value    Pattern
;;-------------- ---------------- ---------------- -------- -------- -------- -------- --------
{inflows}


[DWF]
;;                                Average    Time
;;Node           Constituent      Value      Patterns
;;-------------- ---------------- ---------- ----------
{dwf}

[PATTERNS]
;;Name           Type       Multipliers
;;-------------- ---------- -----------
{patterns}

[CURVES]
;;Name           Type      X-Value     Y-Value
;;-------------- --------- ----------- -----------
{curves}

[TIMESERIES]
;;Name           Date       Time       Value
;;-------------- ---------- ---------- ----------
{timeseries}

[COORDINATES]
;;Node           X-Coord            Y-Coord
;;-------------- ------------------ ------------------
{coordinates}

[VERTICES]
;;Link           X-Coord            Y-Coord
;;-------------- ------------------ ------------------
{vertices}
